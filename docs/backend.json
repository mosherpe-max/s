
{
  "entities": {
    "BuyerProfile": {
      "title": "BuyerProfile",
      "type": "object",
      "description": "Represents a patron or customer using the Koop app to place orders.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "currentLatitude": { "type": "number" },
        "currentLongitude": { "type": "number" },
        "subscriberStatus": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "subscriberStatus", "createdAt", "updatedAt"]
    },
    "Seller": {
      "title": "Seller",
      "type": "object",
      "description": "Represents a venue managing menus and fulfilling orders.",
      "properties": {
        "id": { "type": "string" },
        "courseName": { "type": "string" },
        "type": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "stripeAccountId": { "type": "string", "description": "Linked Stripe Connect account ID" },
        "stripeOnboardingComplete": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "courseName", "contactEmail", "status"]
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "description": "Represents a customer's placed order.",
      "properties": {
        "id": { "type": "string" },
        "buyerProfileId": { "type": "string" },
        "sellerId": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending Payment", "Placed", "Preparing", "Out for Delivery", "Delivered", "Cancelled"] },
        "stripeSessionId": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed"] },
        "total": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}/buyerProfile", "definition": { "entityName": "BuyerProfile" } },
      { "path": "/sellers/{sellerId}", "definition": { "entityName": "Seller" } },
      { "path": "/sellers/{sellerId}/staff/{staffId}", "definition": { "entityName": "StaffMember" } },
      { "path": "/orders/{orderId}", "definition": { "entityName": "Order" } }
    ]
  }
}
