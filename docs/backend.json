
{
  "entities": {
    "Seller": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Seller",
      "type": "object",
      "description": "Represents a seller in the KOOP application.",
      "properties": {
        "ownerId": { "type": "string" },
        "courseName": { "type": "string" },
        "type": { "type": "string" },
        "menuTypes": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Active", "Inactive"] }
      }
    },
    "Prospect": {
      "title": "Prospect",
      "type": "object",
      "description": "Represents a potential venue in the sales pipeline.",
      "properties": {
        "venueName": { "type": "string" },
        "venueType": { "type": "string", "enum": ["Golf Course", "Bowling Alley", "Brewery/Restaurant"] },
        "stage": { "type": "string", "enum": ["Contacted", "Demo Scheduled", "Proposal Sent", "Closed", "Lost"] },
        "contactName": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "assignedRepId": { "type": "string" }
      }
    },
    "SalesActivity": {
      "title": "SalesActivity",
      "type": "object",
      "description": "Log of interactions with prospects.",
      "properties": {
        "prospectId": { "type": "string" },
        "type": { "type": "string", "enum": ["Call", "Email", "Visit", "Meeting"] },
        "notes": { "type": "string" },
        "repId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      { "path": "/sellers/{sellerId}", "definition": { "entityName": "Seller", "description": "Stores seller profiles." } },
      { "path": "/orders/{orderId}", "definition": { "entityName": "Order", "description": "Stores customer orders." } },
      { "path": "/prospects/{prospectId}", "definition": { "entityName": "Prospect", "description": "Sales pipeline prospects." } },
      { "path": "/activities/{activityId}", "definition": { "entityName": "SalesActivity", "description": "Sales activity logs." } }
    ]
  }
}
