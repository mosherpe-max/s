
{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Represents a platform administrator with global access.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "Seller": {
      "title": "Seller",
      "description": "A venue profile including service settings and location.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseName": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "contactEmail": { "type": "string", "format": "email" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" }
      },
      "required": ["id", "courseName", "type", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "A transaction for refreshments placed by a patron.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "sellerId": { "type": "string" },
        "status": { "type": "string" },
        "total": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/roles_admin/{uid}": {
      "schema": { "type": "object", "properties": { "grantedAt": { "type": "string" } } },
      "description": "Security marker for platform administrators."
    },
    "/adminUsers/{uid}": {
      "schema": { "$ref": "#/backend/entities/AdminUser" },
      "description": "Detailed admin profile."
    },
    "/sellers/{sellerId}": {
      "schema": { "$ref": "#/backend/entities/Seller" },
      "description": "Venue registry."
    },
    "/sellers/{sellerId}/menuItems/{itemId}": {
      "schema": "MenuItem",
      "description": "Individual menu items."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/backend/entities/Order" },
      "description": "Customer orders."
    },
    "/prospects/{prospectId}": {
      "schema": "Prospect",
      "description": "Sales pipeline leads."
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "Sales activity logs."
    }
  }
}
