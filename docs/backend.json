
{
  "entities": {
    "Venue": {
      "title": "Venue",
      "type": "object",
      "description": "Represents a recreation venue onboarded to the Koop platform.",
      "properties": {
        "venueId": { "type": "string" },
        "name": { "type": "string" },
        "ownerUid": { "type": "string", "description": "The Firebase Auth UID of the venue manager." },
        "stripeAccountId": { "type": "string", "description": "The unique ID from Stripe Connect." },
        "stripeOnboardingComplete": { "type": "boolean", "description": "Whether the user has completed the Stripe onboarding flow." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["venueId", "name", "ownerUid"]
    },
    "Seller": {
      "title": "Seller",
      "type": "object",
      "description": "Represents a venue managing menus and fulfilling orders.",
      "properties": {
        "id": { "type": "string" },
        "courseName": { "type": "string" },
        "type": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "serviceFee": { "type": "number" },
        "stripeAccountId": { "type": "string" },
        "stripeOnboardingComplete": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "courseName", "contactEmail", "status"]
    },
    "AdminRole": {
      "title": "Admin Role",
      "type": "object",
      "description": "Global platform administrator permission marker.",
      "properties": {
        "grantedAt": { "type": "string", "format": "date-time" },
        "grantedBy": { "type": "string" }
      }
    },
    "SellerAdminRole": {
      "title": "Seller Admin Role",
      "type": "object",
      "description": "Maps a user email to a specific venue for restricted access.",
      "properties": {
        "sellerId": { "type": "string" },
        "courseName": { "type": "string" },
        "assignedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sellerId"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      { "path": "/venues/{venueId}", "definition": { "entityName": "Venue" } },
      { "path": "/sellers/{sellerId}", "definition": { "entityName": "Seller" } },
      { "path": "/roles_admin/{uid}", "definition": { "entityName": "AdminRole" } },
      { "path": "/roles_seller_admin/{email}", "definition": { "entityName": "SellerAdminRole" } }
    ]
  }
}
