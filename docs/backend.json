{
  "entities": {
    "Venue": {
      "title": "Venue",
      "type": "object",
      "description": "Represents the legal/business registry entry for a venue, containing payment and ownership data.",
      "properties": {
        "venueId": { "type": "string" },
        "name": { "type": "string" },
        "ownerUid": { "type": "string", "description": "The Firebase Auth UID of the venue manager." },
        "stripeAccountId": { "type": "string", "description": "The unique ID from Stripe Connect." },
        "stripeOnboardingComplete": { "type": "boolean", "description": "Whether the user has completed the Stripe onboarding flow." },
        "payoutsEnabled": { "type": "boolean", "description": "Manual override to enable payouts for a venue." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["venueId", "name", "ownerUid"]
    },
    "Seller": {
      "title": "Seller",
      "type": "object",
      "description": "The operational profile of a venue managing menus and real-time ordering.",
      "properties": {
        "id": { "type": "string" },
        "courseName": { "type": "string" },
        "type": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "serviceFee": { "type": "number" },
        "taxRate": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "courseName", "contactEmail", "status"]
    },
    "PlatformConfig": {
      "title": "Platform Config",
      "type": "object",
      "description": "Global configuration settings for the KOOP platform.",
      "properties": {
        "supportEmail": { "type": "string", "format": "email" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AdminRole": {
      "title": "Admin Role",
      "type": "object",
      "description": "Global platform administrator permission marker.",
      "properties": {
        "grantedAt": { "type": "string", "format": "date-time" },
        "grantedBy": { "type": "string" }
      }
    },
    "SellerAdminRole": {
      "title": "Seller Admin Role",
      "type": "object",
      "description": "The specific users table mapping authorized emails to establishment IDs.",
      "properties": {
        "sellerId": { "type": "string" },
        "courseName": { "type": "string" },
        "assignedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sellerId"]
    },
    "SalesRepRole": {
      "title": "Sales Rep Role",
      "type": "object",
      "description": "Authorized sales professionals with pipeline management access.",
      "properties": {
        "assignedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      { "path": "/venues/{venueId}", "definition": { "entityName": "Venue" } },
      { "path": "/sellers/{sellerId}", "definition": { "entityName": "Seller" } },
      { "path": "/platform/config", "definition": { "entityName": "PlatformConfig" } },
      { "path": "/roles_admin/{uid}", "definition": { "entityName": "AdminRole" } },
      { "path": "/roles_seller_admin/{email}", "definition": { "entityName": "SellerAdminRole" } },
      { "path": "/roles_sales_rep/{email}", "definition": { "entityName": "SalesRepRole" } }
    ]
  }
}