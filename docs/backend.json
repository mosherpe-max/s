
{
  "entities": {
    "AdminUser": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AdminUser",
      "type": "object",
      "description": "Represents an administrator of the Koop platform.",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "Seller": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Seller",
      "type": "object",
      "description": "Represents a venue (Golf Course, Bowling Alley, etc.) on the KOOP platform.",
      "properties": {
        "id": { "type": "string" },
        "courseName": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "contactName": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" }
      },
      "required": ["id", "courseName", "type", "status"]
    },
    "Prospect": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Prospect",
      "type": "object",
      "description": "A potential venue in the sales pipeline.",
      "properties": {
        "id": { "type": "string" },
        "venueName": { "type": "string" },
        "stage": { "type": "string" },
        "launchFeeQuoted": { "type": "number" }
      },
      "required": ["id", "venueName", "stage"]
    },
    "SalesActivity": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SalesActivity",
      "type": "object",
      "description": "A logged interaction between a sales rep and a prospect.",
      "properties": {
        "id": { "type": "string" },
        "prospectId": { "type": "string" },
        "type": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/roles_admin/{uid}": {
      "schema": { "$ref": "#/backend/entities/AdminUser" },
      "description": "Existence grants KOOP Administrative privileges."
    },
    "/adminUsers/{adminUserId}": {
      "schema": { "$ref": "#/backend/entities/AdminUser" },
      "description": "Extended profile for platform admins."
    },
    "/sellers/{sellerId}": {
      "schema": { "$ref": "#/backend/entities/Seller" },
      "description": "Venue profiles and settings."
    },
    "/sellers/{sellerId}/menuItems/{itemId}": {
      "schema": "MenuItem",
      "description": "Individual items available at a specific venue."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders placed by patrons."
    },
    "/prospects/{prospectId}": {
      "schema": { "$ref": "#/backend/entities/Prospect" },
      "description": "Sales pipeline data."
    },
    "/activities/{activityId}": {
      "schema": { "$ref": "#/backend/entities/SalesActivity" },
      "description": "Sales interaction logs."
    }
  }
}
