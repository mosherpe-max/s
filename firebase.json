
{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "functions": {
      "host": "0.0.0.0",
      "port": 5010
    },
    "firestore": {
      "host": "0.0.0.0",
      "port": 8090
    },
    "ui": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 4020
    },
    "hub": {
      "host": "0.0.0.0",
      "port": 4420
    },
    "auth": {
      "host": "0.0.0.0",
      "port": 9110
    }
  }
}
