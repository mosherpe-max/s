
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'o9vAQy0aFRPSNPoG0ETvjiGt9If1' || 
        request.auth.token.email.lower() == 'mosherpe@gmail.com'
      );
    }

    function isVenueOwner(venueId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/venues/$(venueId)).data.ownerUid == request.auth.uid ||
        (exists(/databases/$(database)/documents/roles_seller_admin/$(request.auth.token.email.lower())) && 
         get(/databases/$(database)/documents/roles_seller_admin/$(request.auth.token.email.lower())).data.sellerId == venueId)
      );
    }

    // Global catch-all for Super Admins
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Allow users to verify their own administrative roles
    match /roles_admin/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
    }

    match /roles_seller_admin/{email} {
      allow read: if isSignedIn() && request.auth.token.email.lower() == email.lower();
    }

    match /roles_sales_rep/{email} {
      allow read: if isSignedIn() && request.auth.token.email.lower() == email.lower();
    }

    // Solution configuration readable by everyone (e.g. for support email access)
    match /solution/config {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Venue registry readable by everyone (contains non-sensitive business names/IDs)
    match /venues/{venueId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isVenueOwner(venueId);
    }

    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isVenueOwner(sellerId);
      
      // Allow location and status updates for authenticated staff
      allow update: if isSignedIn() && 
                    request.resource.data.diff(request.resource.data).affectedKeys()
                    .hasOnly(['latitude', 'longitude', 'lastActive', 'bevcartActive', 'clubhouseActive', 'lanedeliveryActive', 'takeoutActive']);

      match /staff/{staffId} {
        allow read, write: if true;
      }

      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if isSuperAdmin() || isVenueOwner(sellerId);
      }
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Sales CRM access
    match /prospects/{prospectId} {
      allow read, write: if isSignedIn();
    }

    match /activities/{activityId} {
      allow read, write: if isSignedIn();
    }

    // Normalized Menu and Modifiers
    match /modifier_groups/{groupId} {
      allow read: if true;
      // Allow write if the user owns the sellerId associated with the modifier group
      allow write: if isSuperAdmin() || (
        isSignedIn() && 
        (
          (request.method == 'create' || request.method == 'update') && isVenueOwner(request.resource.data.sellerId)
        ) ||
        (
          request.method == 'delete' && isVenueOwner(resource.data.sellerId)
        )
      );
    }
  }
}
