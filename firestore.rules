
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /roles_admin/{uid} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if isAdmin();
    }

    match /adminUsers/{adminUserId} {
      allow get: if isOwner(adminUserId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(adminUserId);
      allow update: if isOwner(adminUserId) || isAdmin();
    }

    match /sellers/{sellerId} {
      allow get: if true; // Publicly readable for ordering
      allow list: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isOwner(sellerId);

      match /menuItems/{itemId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin() || isOwner(sellerId);
      }
    }

    match /orders/{orderId} {
      allow get: if true; // For tracking via unique ID
      allow create: if true; // Guest checkout
      allow list: if isAdmin() || isSignedIn();
      allow update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin();
    }

    match /prospects/{prospectId} {
      allow read, write: if isAdmin() || isSignedIn();
    }

    match /activities/{activityId} {
      allow read, write: if isAdmin() || isSignedIn();
    }
  }
}
