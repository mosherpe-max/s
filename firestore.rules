rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Global Super Admin Access ---
    function isSuperAdmin() {
      return request.auth != null && request.auth.uid == 'o9vAQy0aFRPSNPoG0ETvjiGt9If1';
    }

    // --- Seller Admin Access ---
    function isSellerAdmin(sellerId) {
      return request.auth != null && (
        exists(/databases/$(database)/documents/roles_seller_admin/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/roles_seller_admin/$(request.auth.uid)).data.sellerId == sellerId
      );
    }

    // --- Global Prototype Access for Public Functions ---
    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isSellerAdmin(sellerId);
      
      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if isSuperAdmin() || isSellerAdmin(sellerId);
      }
    }

    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /prospects/{prospectId} {
      allow read, write: if isSuperAdmin();
    }

    match /activities/{activityId} {
      allow read, write: if isSuperAdmin();
    }

    match /roles_admin/{uid} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /adminUsers/{uid} {
      allow read: if true;
      allow write: if isSuperAdmin() || request.auth.uid == uid;
    }

    match /roles_seller_admin/{uid} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
