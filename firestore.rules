
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getEmail() {
      return isSignedIn() && "email" in request.auth.token 
        ? request.auth.token.email.lower() 
        : "";
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'o9vAQy0aFRPSNPoG0ETvjiGt9If1' || 
        getEmail() == 'mosherpe@gmail.com'
      );
    }

    function isAdmin() {
      return isSuperAdmin() || 
             (isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)));
    }

    function isSellerAdmin(sellerId) {
      return isAdmin() || (
        isSignedIn() && 
        getEmail() != "" &&
        exists(/databases/$(database)/documents/roles_seller_admin/$(getEmail())) &&
        get(/databases/$(database)/documents/roles_seller_admin/$(getEmail())).data.get('sellerId', '') == sellerId
      );
    }

    // --- RULES ---

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    /**
     * Role checking rules to allow users to verify their own identities during login/redirection
     */
    match /roles_admin/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
    }

    match /roles_seller_admin/{email} {
      allow get: if isSignedIn() && getEmail() == email.lower();
    }

    match /roles_sales_rep/{email} {
      allow get: if isSignedIn() && getEmail() == email.lower();
    }

    match /adminUsers/{email} {
      allow get: if isSignedIn() && getEmail() == email.lower();
      allow write: if isSuperAdmin();
    }

    /**
     * @description Public platform config (Publishable Keys).
     */
    match /config/platform {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    /**
     * @description Private platform config (Secret Keys).
     */
    match /config/platform_private {
      allow read, write: if isSuperAdmin();
    }

    match /users/{userId}/buyerProfile {
      allow get, list: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || isAdmin();
    }

    match /sellers/{sellerId} {
      allow get, list: if true;
      allow update: if isAdmin() || isSellerAdmin(sellerId);

      match /staff/{staffId} {
        allow get: if true;
        allow list, write: if isAdmin() || isSellerAdmin(sellerId);
      }

      match /menuItems/{itemId} {
        allow get, list: if true;
        allow write: if isAdmin() || isSellerAdmin(sellerId);
      }
    }

    match /orders/{orderId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() || isAdmin();
    }
  }
}
