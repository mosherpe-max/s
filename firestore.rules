/**
 * @file firestore.rules
 * @description Firestore Security Rules for the Koop Application.
 *
 * ## Core Philosophy (PROTOTYPING)
 * This ruleset implements a "Public Read, Public Write" security model FOR PROTOTYPING ONLY.
 * All data related to sellers, menus, and menu items is publicly readable and writable
 * by any user, including anonymous ones. This is to facilitate rapid development and testing.
 *
 * WARNING: THESE RULES ARE INSECURE AND MUST BE REPLACED WITH PROPER
 * AUTHENTICATION-BASED RULES BEFORE GOING TO PRODUCTION.
 *
 * ## Data Structure
 * The data is organized hierarchically:
 * - /sellers/{sellerId}
 *   - /menus/{menuId}
 *     - /menuItems/{menuItemId}
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for the top-level seller profiles collection.
     * @path /sellers/{sellerId}
     * @allow (read) Anyone can read seller data.
     * @allow (write) Anyone can write to seller data (INSECURE - FOR PROTOTYPING).
     */
    match /sellers/{sellerId} {
      allow read, write: if true;
    }

    /**
     * @description Rules for the menus subcollection.
     * @path /sellers/{sellerId}/menus/{menuId}
     * @allow (read) Anyone can read menu data.
     * @allow (write) Anyone can write to menu data (INSECURE - FOR PROTOTYPING).
     */
    match /sellers/{sellerId}/menus/{menuId} {
      allow read, write: if true;
    }

    /**
     * @description Rules for the menuItems subcollection.
     * @path /sellers/{sellerId}/menus/{menuId}/menuItems/{menuItemId}
     * @allow (read) Anyone can read menu item data.
     * @allow (write) Anyone can write to menu item data (INSECURE - FOR PROTOTYPING).
     */
    match /sellers/{sellerId}/menus/{menuId}/menuItems/{menuItemId} {
       allow read, write: if true;
    }
  }
}
