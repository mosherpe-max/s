
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This rule allows anyone, authenticated or not, to read, write, and query
    // any document or collection in the entire database.
    // This is insecure for a production application but is set up
    // for an open prototyping environment.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
