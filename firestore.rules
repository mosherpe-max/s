/**
 * @file firestore.rules
 * @description Firestore Security Rules for the Koop Application.
 *
 * ## Core Philosophy (PROTOTYPING)
 * This ruleset implements a completely open security model where data is publicly
 * readable and writable by anyone to facilitate rapid development and testing.
 *
 * WARNING: THESE RULES ARE INSECURE FOR PRODUCTION AND MUST BE REPLACED
 * WITH SECURE, ROLE-BASED ACCESS CONTROLS BEFORE LAUNCH.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for the top-level seller profiles collection.
     * @path /sellers/{sellerId}
     * @allow (read, write) Anyone can read or write for prototyping.
     */
    match /sellers/{sellerId} {
      allow read, write: if true;
    }

    /**
     * @description Rules for the menuItems subcollection.
     * @path /sellers/{sellerId}/menuItems/{menuItemId}
     * @allow (read, write) Anyone can read or write for prototyping.
     */
    match /sellers/{sellerId}/menuItems/{menuItemId} {
       allow read, write: if true;
    }

    /**
     * @description Rules for the orders collection.
     * @path /orders
     * @allow (list, read, write) Anyone can query or access orders for prototyping.
     */
    match /orders/{orderId} {
      allow list, read, write: if true;
    }
  }
}
