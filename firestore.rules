
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sellers/{sellerId} {
      allow read, write: if true;
    }
    match /sellers/{sellerId}/menuItems/{menuItemId} {
      allow read, write: if true;
    }
    match /orders/{orderId} {
      allow read, write: if true;
    }
  }
}
