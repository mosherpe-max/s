rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY:
     * This ruleset implements a robust, multi-role security model for the Koop platform.
     * It distinguishes between Buyers, Sellers, and Koop Admins using a combination 
     * of path-based ownership and document-level role verification.
     *
     * DATA STRUCTURE:
     * - Buyer data is isolated under /users/{userId}/buyerProfile.
     * - Sellers manage their profiles and hierarchical menus under /sellers/{sellerId}.
     * - Orders and Transactions are centralized top-level collections, secured via 
     *   denormalized participant IDs (buyerProfileId, sellerId).
     *
     * KEY SECURITY DECISIONS:
     * - Denormalization for Authorization: To ensure high performance and avoid 
     *   expensive get() calls, fields like 'buyerProfileId', 'sellerId', and 
     *   'menuIsActive' are stored directly on child documents.
     * - Admin Access: A dedicated /roles_admin collection is used for DBAC (Database Access Control).
     * - Public vs. Private: Product catalogs are readable by all authenticated users, 
     *   while specific order details are restricted to the participants.
     */

    // --- HELPER FUNCTIONS ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the user is an existing owner of the document. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    /** @description Checks if the authenticated user has the Admin role via the roles_admin collection. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** @description Checks if the user is a participant in an order (Buyer or Seller). */
    function isOrderParticipant(data) {
      return isSignedIn() && (data.buyerProfileId == request.auth.uid || data.sellerId == request.auth.uid);
    }

    // --- RULES ---

    /**
     * @description Stores private profile data for each buyer.
     * @path /users/{userId}/buyerProfile
     * @allow (create) if the userId in the path matches the auth UID.
     * @deny (read) if the user is not the owner or an admin.
     * @principle Path-based ownership for private user data.
     */
    match /users/{userId}/buyerProfile {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if (isOwner(userId) && request.resource.data.id == resource.data.id) || isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Core seller profiles, including location for tracking.
     * @path /sellers/{sellerId}
     * @allow (get) if the user is signed in (for map display).
     * @deny (update) if the user is not the seller owner or an admin.
     * @principle Public authenticated read with owner-only writes.
     */
    match /sellers/{sellerId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() || isOwner(sellerId);
      allow update: if isExistingOwner(sellerId) || isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Master list of all products in the system.
     * @path /products/{productId}
     * @allow (list) if any authenticated user is browsing the catalog.
     * @deny (create) if the user is not a Koop Admin.
     * @principle Centralized catalog with admin-only write permissions.
     */
    match /products/{productId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Menus offered by a specific seller.
     * @path /sellers/{sellerId}/menus/{menuId}
     * @allow (get) if menu is active OR user is the seller owner.
     * @deny (create) if the sellerId doesn't match the user's UID.
     * @principle Hierarchical ownership with conditional public visibility.
     */
    match /sellers/{sellerId}/menus/{menuId} {
      allow get, list: if isSignedIn() && (resource.data.isActive == true || isOwner(sellerId) || isAdmin());
      allow create: if isOwner(sellerId) || isAdmin();
      allow update: if isExistingOwner(sellerId) || isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Individual items within a seller's menu.
     * @path /sellers/{sellerId}/menus/{menuId}/items/{itemId}
     * @allow (get) if item is available and menu is active.
     * @deny (update) if the user is not the seller owner.
     * @principle Denormalized status fields ('menuIsActive') allow standalone authorization.
     */
    match /sellers/{sellerId}/menus/{menuId}/items/{itemId} {
      allow get, list: if isSignedIn() && ((resource.data.isAvailable == true && resource.data.menuIsActive == true) || isOwner(sellerId) || isAdmin());
      allow create: if isOwner(sellerId) || isAdmin();
      allow update: if isExistingOwner(sellerId) || isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Centralized collection for all customer orders.
     * @path /orders/{orderId}
     * @allow (create) if the buyerProfileId in the data matches the authenticated user.
     * @deny (get) if the user is not the buyer, the seller, or an admin.
     * @principle Participant-based authorization using denormalized buyer and seller IDs.
     */
    match /orders/{orderId} {
      allow get: if isOrderParticipant(resource.data) || isAdmin();
      allow list: if isSignedIn(); // Queries must filter by buyerProfileId or sellerId
      allow create: if isSignedIn() && request.resource.data.buyerProfileId == request.auth.uid;
      allow update: if (resource != null && isOrderParticipant(resource.data)) || isAdmin();
      allow delete: if isAdmin();

      /**
       * @description Individual items within an order.
       * @path /orders/{orderId}/items/{orderItemId}
       * @allow (get) if the user is a participant of the parent order.
       * @principle Denormalized participant IDs for flat-path authorization.
       */
      match /items/{orderItemId} {
        allow get: if isOrderParticipant(resource.data) || isAdmin();
        allow list: if isSignedIn(); // Queries must filter by participant IDs
        allow create: if isSignedIn() && request.resource.data.buyerProfileId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    /**
     * @description Records of payment transactions.
     * @path /paymentTransactions/{transactionId}
     * @allow (get) if the user is the buyer who made the transaction.
     * @deny (write) to all client-side requests (System/Admin SDK only).
     * @principle Read-only for users; writes restricted to backend processes for financial integrity.
     */
    match /paymentTransactions/{transactionId} {
      allow get: if isSignedIn() && (resource.data.buyerProfileId == request.auth.uid || isAdmin());
      allow list: if isSignedIn(); // Queries must filter by buyerProfileId
      allow create, update, delete: if isAdmin(); // Transactions handled via Cloud Functions (Admin SDK)
    }

    /**
     * @description Administrative roles control collection.
     * @path /roles_admin/{adminUid}
     * @allow (get) if the user is looking up their own status.
     * @deny (write) if the user is not already an admin.
     * @principle Existence-over-content pattern for global role management.
     */
    match /roles_admin/{adminUid} {
      allow get: if isOwner(adminUid) || isAdmin();
      allow list, create, update, delete: if isAdmin();
    }
  }
}