/**
 * @file firestore.rules
 * @description Firestore Security Rules for the Koop Application.
 *
 * ## Core Philosophy (PROTOTYPING)
 * This ruleset implements a security model where data is publicly readable and
 * writable by any authenticated user, including anonymous ones, to facilitate
 * rapid development and testing.
 *
 * WARNING: THESE RULES ARE INSECURE FOR PRODUCTION AND MUST BE REFINED
 * WITH ROLE-BASED ACCESS CONTROLS BEFORE LAUNCH.
 *
 * ## Data Structure
 * The data is organized hierarchically:
 * - /sellers/{sellerId}
 *   - /menuItems/{menuItemId}
 * - /orders/{orderId}
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for the top-level seller profiles collection.
     * @path /sellers/{sellerId}
     * @allow (read, write) Any authenticated user can read or write seller data.
     */
    match /sellers/{sellerId} {
      allow read, write: if request.auth != null;
    }

    /**
     * @description Rules for the menuItems subcollection.
     * @path /sellers/{sellerId}/menuItems/{menuItemId}
     * @allow (read, write) Any authenticated user can read or write menu item data.
     */
    match /sellers/{sellerId}/menuItems/{menuItemId} {
       allow read, write: if request.auth != null;
    }

    /**
     * @description Rules for the orders collection.
     * This rule allows any authenticated user to query (list) the collection.
     * @path /orders
     * @allow (list) Any authenticated user can list orders.
     */
    match /orders/{orderId} {
      allow list, read, write: if request.auth != null;
    }
  }
}
