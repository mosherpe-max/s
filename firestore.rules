
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Role Management ---

    match /roles_admin/{uid} {
      allow get: if isSignedIn();
      allow write: if isOwner(uid); 
      allow list: if isAdmin();
    }

    match /adminUsers/{uid} {
      allow read, write: if isAdmin() || isOwner(uid);
    }

    // --- Core Business Data ---

    match /sellers/{sellerId} {
      // Menus and venue info are public for discovery
      allow read: if true; 
      allow write: if isAdmin();

      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /orders/{orderId} {
      // Prototype: Anyone can place, view, and track orders for a frictionless demo.
      // In a production app, we would restrict listing/updates to staff and the customer.
      allow read, create, update: if true; 
      allow delete: if isAdmin();
    }

    // --- CRM Data ---

    match /prospects/{prospectId} {
      allow read, write: if isAdmin();
    }

    match /activities/{activityId} {
      allow read, write: if isAdmin();
    }
  }
}
