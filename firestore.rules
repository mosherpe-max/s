
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Role Management ---

    match /roles_admin/{uid} {
      allow get: if isSignedIn();
      // Allow self-promotion for the prototype setup tool.
      // In production, this would be restricted to a backend script or existing admins.
      allow write: if isOwner(uid); 
      allow list: if isAdmin();
    }

    match /adminUsers/{uid} {
      allow read, write: if isAdmin() || isOwner(uid);
    }

    // --- Core Business Data ---

    match /sellers/{sellerId} {
      allow get: if true; // Publicly readable for menus
      allow list: if isAdmin(); // Only admins can see the full venue list
      allow create, delete: if isAdmin();
      allow update: if isAdmin(); 

      match /menuItems/{itemId} {
        allow get, list: if true;
        allow write: if isAdmin();
      }
    }

    match /orders/{orderId} {
      allow get: if true; 
      allow create: if true; 
      
      // Scoped listing: Users can only see their own orders. 
      // Admins can see everything.
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 10 && resource.data.customerId == request.auth.uid);
      
      allow update: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- CRM Data ---

    match /prospects/{prospectId} {
      allow read, write: if isAdmin();
    }

    match /activities/{activityId} {
      allow read, write: if isAdmin();
    }
  }
}
