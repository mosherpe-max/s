rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'o9vAQy0aFRPSNPoG0ETvjiGt9If1' || 
        request.auth.token.email.lower() == 'mosherpe@gmail.com'
      );
    }

    // Global catch-all for Super Admins
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Allow users to verify their own administrative roles
    match /roles_admin/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
    }

    match /roles_seller_admin/{email} {
      allow read: if isSignedIn() && request.auth.token.email.lower() == email.lower();
    }

    match /roles_sales_rep/{email} {
      allow read: if isSignedIn() && request.auth.token.email.lower() == email.lower();
    }

    // Platform configuration readable by everyone (e.g. for support email access)
    match /platform/config {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Venue registry readable by everyone (contains non-sensitive business names/IDs)
    match /venues/{venueId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /staff/{staffId} {
        allow read, write: if true;
      }

      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Sales CRM access
    match /prospects/{prospectId} {
      allow read, write: if isSignedIn();
    }

    match /activities/{activityId} {
      allow read, write: if isSignedIn();
    }
  }
}