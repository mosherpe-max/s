
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Core Business Data (PUBLIC FOR PROTOTYPE) ---

    match /sellers/{sellerId} {
      // Open access for frictionless browsing and demo management
      allow read, write: if true; 

      match /menuItems/{itemId} {
        allow read, write: if true;
      }
    }

    match /orders/{orderId} {
      // Prototype: Anyone can place, view, track, and update orders for a frictionless demo.
      // This ensures patrons can order without login and staff can manage without complex auth.
      allow read, create, update: if true; 
      allow delete: if true; 
    }

    // --- Role & CRM Management (OPEN FOR PROTOTYPE) ---

    match /roles_admin/{uid} {
      allow read, write: if true;
    }

    match /adminUsers/{uid} {
      allow read, write: if true;
    }

    match /prospects/{prospectId} {
      allow read, write: if true;
    }

    match /activities/{activityId} {
      allow read, write: if true;
    }
  }
}
