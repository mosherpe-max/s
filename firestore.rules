
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'o9vAQy0aFRPSNPoG0ETvjiGt9If1' || 
        (request.auth.token.email != null && request.auth.token.email.lower() == 'mosherpe@gmail.com')
      );
    }

    function isVenueOwner(venueId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/venues/$(venueId)) && get(/databases/$(database)/documents/venues/$(venueId)).data.ownerUid == request.auth.uid) ||
        (exists(/databases/$(database)/documents/roles_seller_admin/$(request.auth.token.email.lower())) && 
         get(/databases/$(database)/documents/roles_seller_admin/$(request.auth.token.email.lower())).data.sellerId == venueId)
      );
    }

    // A signed-in person (with an email, so never an anonymous patron) who has a sales rep role.
    function isSalesRep() {
      return isSignedIn() && request.auth.token.get('email', null) != null &&
        exists(/databases/$(database)/documents/roles_sales_rep/$(request.auth.token.email.lower()));
    }

    // A staff device signed in through the staffLogin function: its token carries the venue
    // it belongs to. (.get so a token without the claim is simply "no", never an error.)
    function isStaffOf(venueId) {
      return isSignedIn() && request.auth.token.get('staffSellerId', null) == venueId;
    }

    // User profiles - patrons can read/write their own identity
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Solution configuration readable by everyone
    match /solution/config {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Patron Terms & Conditions: patrons read the current version at checkout;
    // only a super admin publishes a new one, and every published version is
    // kept (admin-only) as a record of what patrons agreed to.
    match /solution/patronTerms {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /versions/{versionId} {
        allow read, write: if isSuperAdmin();
      }
    }

    // Global Starter Libraries
    match /starter_modifier_library/{groupId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /starter_menu_item_library/{itemId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Global catch-all for Super Admins
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Allow users to verify their own administrative roles
    match /roles_admin/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
    }

    match /roles_seller_admin/{email} {
      allow read: if isSignedIn() && request.auth.token.email.lower() == email.lower();
    }

    match /roles_sales_rep/{email} {
      allow read: if isSignedIn() && request.auth.token.email.lower() == email.lower();
    }

    // Venue registry
    match /venues/{venueId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isVenueOwner(venueId);
    }

    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isVenueOwner(sellerId);
      
      // Allow location and status updates
      // Prototyping: Allow demo venues to be toggled without authentication
      // Service mode open/closed (bevcartActive/clubhouseActive/lanedeliveryActive)
      // is intentionally NOT in this list - only the venue owner (or super admin,
      // via the "allow write" rule above) may open or close a service mode.
      // The *PausedByStaff and *AutoThrottled flags ARE intentionally here,
      // unlike the *Active flags above - any signed-in staff device needs to
      // be able to pause/resume new orders for a mode it's actively working,
      // and to let the terminal that's watching the live queue flip the
      // auto-throttle flag when it crosses a threshold.
      allow update: if (isSignedIn() || sellerId.startsWith('demo-')) &&
                    request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly([
                      'latitude', 'longitude', 'lastActive', 'updatedAt', 'qrActive', 'qrSecret',
                      'bevcartPausedByStaff', 'clubhousePausedByStaff', 'lanedeliveryPausedByStaff',
                      'bevcartAutoThrottled', 'clubhouseAutoThrottled', 'lanedeliveryAutoThrottled'
                    ]);

      match /staff/{staffId} {
        // Read stays open: the PIN login screen looks up a staff doc by PIN
        // before the device has signed in (see the anonymous-auth carve-out
        // below), so it can't yet satisfy isSignedIn().
        allow read: if true;
        allow write: if isSuperAdmin() || isVenueOwner(sellerId);

        // On-shift staff devices sign in anonymously (no admin rights) after
        // PIN verification, and need to keep their own operational status
        // current - active shift/session, heartbeat, availability, and live
        // location - without full staff-editing rights (PIN, name, role).
        allow update: if isSignedIn() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['activeMode', 'activeSessionId', 'lastActive', 'isAvailable', 'latitude', 'longitude', 'currentDeviceId']);
      }

      // Staff login PINs. Kept apart from the staff records because those are readable by
      // patrons' browsers; only the venue admin and Koop admin can read or set a PIN, and
      // staff sign in through the staffLogin function, which checks them on the server.
      match /staffSecrets/{staffId} {
        allow read, write: if isSuperAdmin() || isVenueOwner(sellerId);
      }

      // A browser/device's Web Push subscription (see PushDevice type) -
      // written once from Safari before the PWA is added to the Home
      // Screen. Not staff-specific; a shared terminal's subscription
      // outlives whichever staff member happens to be signed into it.
      match /pushDevices/{deviceId} {
        allow read: if isSuperAdmin() || isVenueOwner(sellerId);
        allow write: if isSignedIn();
      }

      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if isSuperAdmin() || isVenueOwner(sellerId);

        // Staff on shift need to 86 an item (mark it out of stock on their
        // cart/station) and un-86 it, without full menu-editing rights -
        // restricted to just this one field.
        allow update: if isSignedIn() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['outOfStockModes']);
      }

      // Daily Sales Report bookkeeping locks - one doc per (day, service
      // mode) once that day has ended. The venue owner may create a lock
      // (the report page does this the first time it computes a past day
      // that hasn't been locked yet) but never alter one afterward, so a
      // later fee-setting change or order edit can't silently rewrite a
      // day the venue already logged in their own books.
      match /dailySalesLocks/{lockId} {
        allow read: if isSuperAdmin() || isVenueOwner(sellerId);
        allow create: if isSuperAdmin() || isVenueOwner(sellerId);
        allow update, delete: if isSuperAdmin();
      }
    }

    match /orders/{orderId} {
      // One order by its id stays open: order ids are long and random, and the tracking link
      // texted to a patron has to work on a phone that isn't the one that placed the order.
      allow get: if true;
      // Lists/queries are limited to the people who need them: the patron's own orders, the
      // venue's signed-in staff, the venue admin, and the Koop admin. Nobody else can pull
      // down every order (with names, phones and emails) in one go.
      allow list: if (isSignedIn() && resource.data.buyerProfileId == request.auth.uid) ||
                     isStaffOf(resource.data.sellerId) ||
                     isVenueOwner(resource.data.sellerId) ||
                     isSuperAdmin();

      // A patron places their own order: it must be in their name and start as Placed, with
      // none of the fields only staff set.
      allow create: if isSignedIn() &&
                       request.resource.data.buyerProfileId == request.auth.uid &&
                       request.resource.data.status == 'Placed' &&
                       request.resource.data.sellerId is string &&
                       !request.resource.data.keys().hasAny([
                         'assignedStaffId', 'assignedStaffName', 'preparedByStaffId', 'preparedByStaffName',
                         'acknowledgedAt', 'deliveredAt'
                       ]);

      allow update: if isSuperAdmin() || isVenueOwner(resource.data.sellerId) ||

                       // Staff signed in for this venue work the order: status, who has it, timing,
                       // and asking the patron to refresh their location. Never who it's for or the money.
                       (isStaffOf(resource.data.sellerId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status', 'deliveredAt', 'acknowledgedAt', 'assignedStaffId', 'assignedStaffName',
                          'preparedByStaffId', 'preparedByStaffName', 'refreshRequestedAt', 'updatedAt'
                        ])) ||

                       // The patron who placed it can only move where it should be brought...
                       (isSignedIn() && resource.data.buyerProfileId == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'deliveryLocation', 'lastGpsUpdate', 'deliveryHole', 'deliveryHoleUpdatedAt',
                          'menuTypeLocation', 'updatedAt'
                        ])) ||

                       // ...or finish placing it. A card payment's order record is started by the Stripe
                       // webhook and completed by the patron's browser, so for a brief moment, while it
                       // is still Placed and nobody has picked it up, they may fill in the order details.
                       (isSignedIn() && resource.data.buyerProfileId == request.auth.uid &&
                        resource.data.status == 'Placed' && request.resource.data.status == 'Placed' &&
                        !('assignedStaffId' in resource.data) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'items', 'subtotal', 'serviceFee', 'tax', 'tip', 'total', 'status', 'paymentMethod',
                          'paymentStatus', 'stripePaymentIntentId', 'menuType', 'menuTypeLocation', 'createdAt', 'updatedAt',
                          'sellerId', 'buyerProfileId', 'customerName', 'customerPhone', 'customerEmail',
                          'deliveryLocation', 'lastGpsUpdate', 'deliveryHole', 'deliveryHoleUpdatedAt',
                          'termsAcceptedVersion', 'termsAcceptedAt'
                        ]));

      allow delete: if isSuperAdmin() || isVenueOwner(resource.data.sellerId);
    }

    // One timing record per order (what the venue looked like when it was placed and when each step
    // happened), kept by the recordOrderTiming function as the history delivery-time estimates will be built
    // from. No personal details. Only the Koop admin can read it, and the app itself never writes to it.
    match /orderTimings/{orderId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // A copy of each in-progress order with no personal details (venue, service mode, status,
    // placed time), kept by the syncOrderQueue function. It lets a patron see their place in
    // line without being able to read other people's orders.
    match /orderQueue/{orderId} {
      allow read: if true;
      allow write: if false;
    }

    // Sales rep CRM. Holds prospects' contact details and the fees quoted to them, so only the Koop admin and
    // people with a sales rep role (roles_sales_rep, keyed by email) can see or change it - not every signed-in
    // visitor, which includes patrons who only placed an order.
    match /prospects/{prospectId} {
      allow read, write: if isSuperAdmin() || isSalesRep();
    }

    match /activities/{activityId} {
      allow read, write: if isSuperAdmin() || isSalesRep();
    }

    // Normalized Menu and Modifiers
    match /modifier_groups/{groupId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (
        isSignedIn() && 
        (
          (request.method == 'create' || request.method == 'update') && isVenueOwner(request.resource.data.sellerId)
        ) ||
        (
          request.method == 'delete' && isVenueOwner(resource.data.sellerId)
        )
      );
    }
  }
}
