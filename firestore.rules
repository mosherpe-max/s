
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Role Management ---

    match /roles_admin/{uid} {
      allow get: if isSignedIn();
      // Allow self-promotion for the prototype setup tool.
      allow write: if isOwner(uid); 
      allow list: if isAdmin();
    }

    match /adminUsers/{uid} {
      allow read, write: if isAdmin() || isOwner(uid);
    }

    // --- Core Business Data ---

    match /sellers/{sellerId} {
      allow get: if true; 
      allow list: if isAdmin(); 
      allow create, delete, update: if isAdmin();

      match /menuItems/{itemId} {
        allow get, list: if true;
        allow write: if isAdmin();
      }
    }

    match /orders/{orderId} {
      allow get: if true; 
      allow create: if true; 
      
      // Allow admins to list all, and users to list only their own via filtered query
      allow list: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.customerId);
      
      allow update: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- CRM Data ---

    match /prospects/{prospectId} {
      allow read, write: if isAdmin();
    }

    match /activities/{activityId} {
      allow read, write: if isAdmin();
    }
  }
}
