
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY:
     * This ruleset implements a robust, multi-role security model for the Koop platform.
     * Super Admins have global override privileges.
     */

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Priority 1: Direct UID match for Super Admin
      // Priority 2: Registry lookup for Platform Admins
      return isSignedIn() && (
        request.auth.uid == 'o9vAQy0aFRPSNPoG0ETvjiGt9If1' ||
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function isSalesRep() {
      return isSignedIn() && 
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/roles_sales_rep/$(request.auth.token.email.lower()));
    }

    function isDemoVenue(sellerId) {
      return sellerId.startsWith('demo-');
    }

    function isSellerAdmin(sellerId) {
      // Defensive check for email and document existence
      return isSignedIn() && 
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/roles_seller_admin/$(request.auth.token.email.lower())) &&
             get(/databases/$(database)/documents/roles_seller_admin/$(request.auth.token.email.lower())).data.sellerId == sellerId;
    }

    function canImpersonate(sellerId) {
      return isAdmin() || isSellerAdmin(sellerId) || (isSalesRep() && isDemoVenue(sellerId));
    }

    function isOrderParticipant(data) {
      return isSignedIn() && (data.buyerProfileId == request.auth.uid || data.sellerId == request.auth.uid);
    }

    // --- RULES ---

    /**
     * @description Vault for sensitive credentials. Controlled by Admin only.
     */
    match /sellers_private/{sellerId} {
      allow read, write: if isAdmin();
    }

    /**
     * @description Stores private profile data for each buyer.
     */
    match /users/{userId}/buyerProfile {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if (isOwner(userId) && request.resource.data.id == resource.data.id) || isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Core seller profiles, including location for tracking.
     */
    match /sellers/{sellerId} {
      allow get, list: if true; // Publicly accessible for discovery
      allow create: if isAdmin() || isOwner(sellerId);
      allow update: if isExistingOwner(sellerId) || isAdmin() || isSellerAdmin(sellerId);
      allow delete: if isAdmin();

      match /staff/{staffId} {
        // Managers and Sales Reps (for demos) can list staff
        allow list: if canImpersonate(sellerId);
        // Allow specific document access for anyone (needed for PIN lookup query)
        allow get: if true; 
        // Modifications restricted to actual managers
        allow create, update, delete: if isAdmin() || isSellerAdmin(sellerId);
      }

      match /menuItems/{itemId} {
        allow get, list: if true; // Publicly accessible for guest ordering
        allow create, update, delete: if isOwner(sellerId) || isAdmin() || isSellerAdmin(sellerId);
      }

      match /menus/{menuId} {
        allow get, list: if (resource.data.isActive == true || isOwner(sellerId) || isAdmin() || isSellerAdmin(sellerId));
        allow create: if isOwner(sellerId) || isAdmin() || isSellerAdmin(sellerId);
        allow update: if isExistingOwner(sellerId) || isAdmin() || isSellerAdmin(sellerId);
        allow delete: if isAdmin();

        match /items/{itemId} {
          allow get, list: if ((resource.data.isAvailable == true && resource.data.menuIsActive == true) || isOwner(sellerId) || isAdmin() || isSellerAdmin(sellerId));
          allow create: if isOwner(sellerId) || isAdmin() || isSellerAdmin(sellerId);
          allow update: if isExistingOwner(sellerId) || isAdmin() || isSellerAdmin(sellerId);
          allow delete: if isAdmin();
        }
      }
    }

    /**
     * @description Master list of all products in the system.
     */
    match /products/{productId} {
      allow get, list: if true; 
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Centralized collection for all customer orders.
     */
    match /orders/{orderId} {
      allow get: if isOrderParticipant(resource.data) || canImpersonate(resource.data.sellerId);
      allow list: if isSignedIn(); 
      allow create: if isSignedIn() && request.resource.data.buyerProfileId == request.auth.uid;
      allow update: if (resource != null && (isOrderParticipant(resource.data) || canImpersonate(resource.data.sellerId))) || isAdmin();
      allow delete: if isAdmin();

      match /items/{orderItemId} {
        allow get: if isOrderParticipant(resource.data) || canImpersonate(resource.data.sellerId);
        allow list: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.buyerProfileId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    /**
     * @description Records of payment transactions.
     */
    match /paymentTransactions/{transactionId} {
      allow get: if isSignedIn() && (resource.data.buyerProfileId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /prospects/{prospectId} {
      allow read, write: if isSignedIn();
    }

    match /activities/{activityId} {
      allow read, write: if isSignedIn();
    }

    match /adminUsers/{email} {
      allow read, write: if isSignedIn();
    }

    match /roles_seller_admin/{email} {
      allow read, write: if isSignedIn();
    }

    match /roles_sales_rep/{email} {
      allow read, write: if isSignedIn();
    }

    match /roles_admin/{adminUid} {
      allow get: if isOwner(adminUid) || isAdmin();
      allow list, create, update, delete: if isAdmin();
    }
  }
}
